{
  "name": "crbgc",
  "compatibility_date": "2026-10-12",
  // The whole build, run before every deploy on a Mac (task deploy) or in
  // Workers Builds: the two task check commands, the validate pass over drafts
  // and future-dated posts, then the production build. rm -rf because Hugo
  // never prunes public/. bun is pinned through bunx because the build image's
  // own bun may predate 1.4.4, the first release with bun fmt.
  "build": {
    "command": "bunx bun@1.4.4 fmt --check && bunx biome check assets && hugo --buildFuture -D --renderToMemory --gc --panicOnWarning && rm -rf public && hugo --minify --gc --panicOnWarning",
  },
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  // Mondays 09:00 UTC (05:00 Eastern in summer, 04:00 in winter): rebuild so
  // future-dated posts go live. DEPLOY_HOOK is a secret: see the README.
  "triggers": { "crons": ["0 9 * * 1"] },
  // The custom domain is the only address: no workers.dev, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs, free tier: keeps the Worker's errors, including a failed cron, for 3 days.
  "observability": { "enabled": true },
  "routes": [{ "pattern": "crbgc.org", "custom_domain": true }],
}
