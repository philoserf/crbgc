{
  "name": "crbgc",
  "compatibility_date": "2026-10-12",
  // The whole build, run before every deploy on a Mac (task deploy) or in
  // Workers Builds: the two task check commands, the validate pass over drafts
  // and future-dated posts, then the production build. rm -rf because Hugo
  // never prunes public/.
  "build": {
    "command": "bunx prettier --check '**/*.{md,html,yml,yaml,toml,json}' && bunx biome check assets && hugo --buildFuture -D --renderToMemory --gc --panicOnWarning && rm -rf public && hugo --minify --gc --panicOnWarning",
  },
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "crbgc.org", "custom_domain": true }],
}
